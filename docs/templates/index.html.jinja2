{# Page d'accueil du site : la chaîne, puis l'arborescence des modules.

   Le site est engendré par `tools/docs.py`. Ce qui est ajouté ici, c'est de quoi savoir par où entrer.

   Tous les modules descendant de `src`, pdoc renverrait par défaut vers la page
   de `src` sans s'arrêter ici. `root_module_name` à faux lui fait rendre cette
   page-ci : c'est la manière que son propre gabarit indique. #}
{% set root_module_name = false %}
{% extends "default/index.html.jinja2" %}
{% import "nav-tree.html.jinja2" as navigation with context %}

{# Les parties du projet, dans l'ordre de la chaîne. #}
{% set parts = [
    ("main", "main",
     "Le chef d'orchestre&nbsp;: il enchaîne les étapes,.",
     "python main.py rapport.pbip"),
    ("src.pbi_extractor", "pbi_extractor",
     "Lit le projet <code>.pbip</code> — modèle sémantique, rapport, dépendances entre
      mesures — et retourne un <code>PowerBiMetadata</code>.", ""),
    ("src.report_generator", "report_generator",
     "Écrit le <code>.docx</code> en suivant le plan YAML, et reprend ce qui avait été
      rédigé dans la version précédente.", ""),
    ("src.core", "core",
     "Le socle commun&nbsp;: modèles, plan YAML, console, chemins, questions. Les deux
      modules en dépendent.", ""),
] %}
{% set shown = parts | selectattr("0", "in", all_modules) | list %}

{% block title %}Documentation du code — Power BI Doc{% endblock %}

{% block nav %}
    <h2>Les modules</h2>
    {{ navigation.arbre(ouvert=true) | safe }}
{% endblock %}

{% block content %}
    <main class="pdoc landing">
        <h1>Documentation du code du Générateur de documentation Power BI</h1>

        {# Le champ que `search.html.jinja2` met en service. Sans lui, l'accueil
           serait la seule page du site où l'on ne peut pas chercher. #}
        {% if search %}
            <input type="search" placeholder="Chercher dans la documentation…"
                   aria-label="recherche">
        {% endif %}

        <p class="lead">
            Générateur de documentation Word pour un rapport Power BI&nbsp;(<code>.pbip</code>).
            Un seul programme, découpé en <strong>deux modules</strong> qui ont chacun une
            responsabilité et une seule&nbsp;: lire le rapport, écrire le document.
        </p>

        <pre class="chain">.pbip  ──►  pbi_extractor  ──►  report_generator  ──►  .docx</pre>

        <div class="cards">
            {% for module, name, description, run in shown %}
                <a class="card" href="{{ module.replace(".", "/") }}.html">
                    <h3>{{ name }}</h3>
                    <p>{{ description | safe }}</p>
                    {% if run %}<code class="run">{{ run }}</code>{% endif %}
                </a>
            {% endfor %}
        </div>

        {% if "src.core.models" in all_modules %}
            <h2>Ce qui circule d'une étape à l'autre</h2>
            <p>
                Un seul objet, d'un bout à l'autre&nbsp;: le
                <a href="src/core/models.html"><code>PowerBiMetadata</code></a>. Rien ne
                transite par le disque entre deux étapes&nbsp;— pas de fichier intermédiaire à
                écrire, à relire, à supprimer ni à tenir à jour.
            </p>
        {% endif %}

        <p class="hint">
            Ces pages sont engendrées par <code>tools/docs.py</code> à partir des docstrings et
            des annotations du code&nbsp;: elles ne peuvent pas se périmer sans que le code
            change. <code>task docs</code> les sert avec rechargement à chaud.
        </p>
    </main>
    {% if search %}
        {% include "search.html.jinja2" %}
    {% endif %}
{% endblock %}
